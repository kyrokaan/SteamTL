{
  "manifest_version": 3,
  "name": "Steam TL — USD Fiyat Dönüştürücü",
  "version": "1.8.14",
  "description": "Steam mağazasındaki USD fiyatlarını yaklaşık TL karşılığıyla gösterir. Otomatik veya elle girilen kur kullanır.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://www.ecb.europa.eu/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Steam TL", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "content_scripts": [{
    "matches": ["https://store.steampowered.com/*"],
    "js": ["core.js", "i18n.js", "content.js"],
    "run_at": "document_idle"
  }]
}
